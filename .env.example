# Copy this file to .env and adjust as needed.
# All variables are optional; defaults are shown below.

# Deployment environment: development | staging | production
TICKSTREAM_ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
TICKSTREAM_LOG_LEVEL=INFO

# Emit JSON logs instead of human-readable (true | false)
TICKSTREAM_LOG_JSON=false

# Binance endpoints (public market data — no API key required)
TICKSTREAM_BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
TICKSTREAM_BINANCE_REST_BASE_URL=https://api.binance.com

# Default symbols for the live demo (comma-separated, lowercased)
TICKSTREAM_DEMO_SYMBOLS=btcusdt,ethusdt

# Number of trades to capture before exiting the demo
TICKSTREAM_DEMO_COUNT=5

# SQLite database path (relative or absolute)
TICKSTREAM_DEMO_DB=tickstream.db
